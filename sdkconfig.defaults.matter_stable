# Conservative Matter build layered on the validated recovery baseline.

CONFIG_CONTROL_RECOVERY_BUILD=n
CONFIG_CONTROL_MATTER_CONTROLLER=y
CONFIG_CONTROL_MATTER_COMMISSIONING=y
CONFIG_CONTROL_MATTER_COMMISSIONING_EXPERIMENTAL=y
CONFIG_CONTROL_MATTER_ALLOW_UNTRUSTED_ATTESTATION=y

# ESP-Matter controller/commissioner integration.
CONFIG_ENABLE_CHIP_SHELL=n
CONFIG_ENABLE_CHIP_CONTROLLER_BUILD=y
CONFIG_ESP_MATTER_CONTROLLER_ENABLE=y
CONFIG_ESP_MATTER_COMMISSIONER_ENABLE=y
CONFIG_ESP_MATTER_ENABLE_MATTER_SERVER=n
CONFIG_WIFI_NETWORK_COMMISSIONING_DRIVER=n
CONFIG_MBEDTLS_HKDF_C=y
CONFIG_NUM_UDP_ENDPOINTS=16
CONFIG_ESP_MATTER_MAX_DYNAMIC_ENDPOINT_COUNT=2
CONFIG_ESP_MATTER_MAX_DEVICE_TYPE_COUNT=2
CONFIG_CHIP_TASK_STACK_SIZE=24576
CONFIG_CHIP_PROJECT_CONFIG="main/matter_project_config.h"

# Matter commissionable discovery uses CHIP Minimal mDNS.
CONFIG_USE_MINIMAL_MDNS=y
CONFIG_CONTROL_UI_DASHBOARD_V1=y
CONFIG_CONTROL_UI_MATTER_COMMANDS=y

# On-network commissioning does not use the Bluetooth controller.
# CONFIG_BT_ENABLED is not set
# CONFIG_BT_NIMBLE_ENABLED is not set
# CONFIG_ENABLE_CHIPOBLE is not set
# CONFIG_ENABLE_ESP32_BLE_CONTROLLER is not set
# CONFIG_USE_BLE_ONLY_FOR_COMMISSIONING is not set

# Preserve the validated recovery runtime settings.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=24576
CONFIG_ESP_TIMER_TASK_STACK_SIZE=4096
# CONFIG_NEWLIB_NANO_FORMAT is not set
# CONFIG_NVS_ALLOCATE_CACHE_IN_SPIRAM is not set
# CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY is not set
# CONFIG_SPIRAM_ALLOW_NOINIT_SEG_EXTERNAL_MEMORY is not set
# CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP is not set
# CONFIG_FREERTOS_TASK_CREATE_ALLOW_EXT_MEM is not set
# CONFIG_FREERTOS_PLACE_FUNCTIONS_INTO_FLASH is not set
# CONFIG_RINGBUF_PLACE_FUNCTIONS_INTO_FLASH is not set
# CONFIG_HEAP_PLACE_FUNCTION_INTO_FLASH is not set

# Matter application layout.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_matter.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions_matter.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x8000

CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384
CONFIG_ESP_CONSOLE_USB_CDC=y
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LWIP_SNTP_MAX_SERVERS=3
CONFIG_CONTROL_IKEA_DISCOVERY=y
CONFIG_CONTROL_IKEA_LEGACY_MDNS_DISCOVERY=y
CONFIG_CONTROL_IKEA_HOSTNAME_FALLBACK=y
CONFIG_CONTROL_IKEA_IP_DIAGNOSTICS=y
CONFIG_CONTROL_IKEA_KNOWN_IP="192.168.50.116"
# CONFIG_CONTROL_NET_DIAG_PING_SWEEP is not set
CONFIG_CONTROL_MATTER_CONTROLLER=y
CONFIG_CONTROL_MATTER_COMMISSIONING=y
# CONFIG_CONTROL_MATTER_COMMISSIONING_EXPERIMENTAL is not set
# CONFIG_CONTROL_MATTER_ALLOW_UNTRUSTED_ATTESTATION is not set
CONFIG_CONTROL_TOUCH_UI_DISPATCH=y
CONFIG_CONTROL_TOUCH_DEBUG=y
CONFIG_CONTROL_TOUCH_TASK_STACK_SIZE=4096
# Password/Matter input screens must not use automatic partial refresh by
# default. Region refresh on the physical e-paper panel produced overdraw and
# unusable input. Keep the code available for future experiments only.
# CONFIG_CONTROL_ENABLE_PARTIAL_REFRESH is not set
# CONFIG_CONTROL_PASSWORD_FIELD_PARTIAL_REFRESH is not set
# CONFIG_CONTROL_PASSWORD_KEYBOARD_PARTIAL_REFRESH is not set
CONFIG_CONTROL_PASSWORD_PARTIALS_BEFORE_FULL_REFRESH=20
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384
CONFIG_FREERTOS_WATCHPOINT_END_OF_STACK=y
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y
CONFIG_COMPILER_CXX_EXCEPTIONS=n
CONFIG_COMPILER_CXX_RTTI=n
